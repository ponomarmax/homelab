{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.local/schemas/payloads/polar/polar.hr.v1.schema.json",
  "title": "polar.hr v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "samples"
  ],
  "properties": {
    "stream_settings": {
      "type": "object",
      "additionalProperties": true
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "received_at_collector",
          "hr",
          "ppg_quality",
          "corrected_hr",
          "rrs_ms",
          "rr_available",
          "contact_status",
          "contact_status_supported"
        ],
        "properties": {
          "received_at_collector": {
            "type": "string",
            "format": "date-time"
          },
          "hr": {
            "type": "integer",
            "minimum": 0
          },
          "ppg_quality": {
            "type": "integer"
          },
          "corrected_hr": {
            "type": "integer",
            "minimum": 0
          },
          "rrs_ms": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "rr_available": {
            "type": "boolean"
          },
          "contact_status": {
            "type": "boolean"
          },
          "contact_status_supported": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

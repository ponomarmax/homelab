{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.local/schemas/payloads/polar/polar.offline.mag.v1.schema.json",
  "title": "polar.offline.mag v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "source", "samples"],
  "properties": {
    "type": { "const": "MAG" },
    "source": { "const": "polar_verity_sense_offline" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeStamp", "x", "y", "z"],
        "properties": {
          "timeStamp": { "type": "integer", "minimum": 0 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        }
      }
    }
  }
}

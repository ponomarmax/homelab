{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.local/schemas/payloads/polar/polar.offline.hr.v1.schema.json",
  "title": "polar.offline.hr v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "source", "samples"],
  "properties": {
    "type": { "const": "HR" },
    "source": { "const": "polar_verity_sense_offline" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_index", "hr", "ppg_quality", "corrected_hr", "rrs_ms", "rr_available", "contact_status", "contact_status_supported"],
        "properties": {
          "sample_index": { "type": "integer", "minimum": 0 },
          "hr": { "type": "integer", "minimum": 0 },
          "ppg_quality": { "type": "integer" },
          "corrected_hr": { "type": "integer", "minimum": 0 },
          "rrs_ms": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "rr_available": { "type": "boolean" },
          "contact_status": { "type": "boolean" },
          "contact_status_supported": { "type": "boolean" }
        }
      }
    }
  }
}

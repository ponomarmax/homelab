{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.local/schemas/payloads/polar/polar.offline.ppg.v1-draft.schema.json",
  "title": "polar.offline.ppg v1-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recording",
    "units",
    "samples"
  ],
  "properties": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "PPG"
        },
        "source": {
          "type": "string",
          "const": "polar_verity_sense_offline"
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_timestamp_ns",
        "ppg0",
        "ppg1",
        "ppg2",
        "ambient"
      ],
      "properties": {
        "raw_timestamp_ns": {
          "type": "string",
          "const": "ns"
        },
        "ppg0": {
          "type": "string",
          "const": "raw_int"
        },
        "ppg1": {
          "type": "string",
          "const": "raw_int"
        },
        "ppg2": {
          "type": "string",
          "const": "raw_int"
        },
        "ambient": {
          "type": "string",
          "const": "raw_int"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_index",
          "raw_timestamp_ns",
          "ppg0",
          "ppg1",
          "ppg2",
          "ambient"
        ],
        "properties": {
          "sample_index": {
            "type": "integer",
            "minimum": 0
          },
          "raw_timestamp_ns": {
            "type": "integer",
            "minimum": 0
          },
          "ppg0": {
            "type": "integer"
          },
          "ppg1": {
            "type": "integer"
          },
          "ppg2": {
            "type": "integer"
          },
          "ambient": {
            "type": "integer"
          }
        }
      }
    }
  }
}

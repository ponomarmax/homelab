{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.local/schemas/payloads/polar/polar.offline.mag.v1-draft.schema.json",
  "title": "polar.offline.mag v1-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recording",
    "units",
    "channels",
    "samples"
  ],
  "properties": {
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "MAG"
        },
        "source": {
          "type": "string",
          "const": "polar_verity_sense_offline"
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_timestamp_ns",
        "x_gauss",
        "y_gauss",
        "z_gauss"
      ],
      "properties": {
        "raw_timestamp_ns": {
          "type": "string",
          "const": "ns"
        },
        "x_gauss": {
          "type": "string",
          "const": "gauss"
        },
        "y_gauss": {
          "type": "string",
          "const": "gauss"
        },
        "z_gauss": {
          "type": "string",
          "const": "gauss"
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "x_gauss",
          "y_gauss",
          "z_gauss"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_index",
          "raw_timestamp_ns",
          "x_gauss",
          "y_gauss",
          "z_gauss"
        ],
        "properties": {
          "sample_index": {
            "type": "integer",
            "minimum": 0
          },
          "raw_timestamp_ns": {
            "type": "integer",
            "minimum": 0
          },
          "x_gauss": {
            "type": "number"
          },
          "y_gauss": {
            "type": "number"
          },
          "z_gauss": {
            "type": "number"
          }
        }
      }
    }
  }
}
